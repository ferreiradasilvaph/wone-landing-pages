# Copie para `.env.local` e ajuste os valores.

# Canal, grupo ou bot aberto depois que o visitante entra na lista de espera.
# Sem esta variável o botão cai no genérico https://t.me/, que não leva a
# lugar nenhum em particular.
# Por ser NEXT_PUBLIC_*, o valor é embutido durante o `next build` — alterá-la
# exige um novo build, não basta reiniciar o servidor.
NEXT_PUBLIC_TELEGRAM_URL=https://t.me/seucanal

# URL pública do site, usada nas metatags de Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.exemplo.com.br

# Para onde o cadastro da lista de espera é enviado: qualquer endereço que
# aceite um POST com JSON (função da Supabase, webhook do n8n/Make/Zapier, canal
# do Discord, rota do seu back-end). O corpo é o próprio cadastro: name, email,
# telegram, nationality, phone e createdAt.
# SEM esta variável o cadastro só vai para o log do servidor — ou seja, some no
# próximo deploy, e o visitante vê "você está na fila" mesmo assim.
# Não é NEXT_PUBLIC_*: o valor fica no servidor e nunca chega ao navegador.
WAITLIST_WEBHOOK_URL=https://exemplo.com/webhook/lista-de-espera
