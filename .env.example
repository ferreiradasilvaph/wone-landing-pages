# Copie para `.env.local` e ajuste os valores.

# Canal, grupo ou bot aberto depois que o visitante entra na lista de espera.
# Sem esta variável o botão cai no genérico https://t.me/, que não leva a
# lugar nenhum em particular.
# Por ser NEXT_PUBLIC_*, o valor é embutido durante o `next build` — alterá-la
# exige um novo build, não basta reiniciar o servidor.
NEXT_PUBLIC_TELEGRAM_URL=https://t.me/seucanal

# URL pública do site, usada nas metatags de Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.exemplo.com.br
