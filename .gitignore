# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Referencia visual da plataforma: conteudo fora do repo da landing
/referencia-fluxos/*
!/referencia-fluxos/README.md

# Relatorios do Lighthouse (grandes, gerados localmente)
lighthouse-*.report.html
lighthouse-*.report.json

# Saida de `npm run perf`: JSON do Lighthouse e a tabela da rodada. Descrevem
# uma maquina e um instante, nao o codigo; a pasta e recriada a cada medicao.
/.lighthouse/

# Saida do Playwright MCP (capturas, logs de console, snapshots .yml). Mesma
# natureza do /.lighthouse/: evidencia de uma verificacao, nao codigo. Sao
# megabytes de JPG — a pasta estava com 2,1 MB em 13 arquivos, um deles de
# 1,06 MB e de um site de terceiro — e `git status` listava tudo como novo,
# pronto para entrar num `git add -A` distraido.
/.playwright-mcp/

# Registro verbatim dos prompts: fica local, fora do repo publico
prompts-originais.local.txt
